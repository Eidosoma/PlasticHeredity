{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidosoma.local/e01/s12fr/pair-diagnostic-v1.0.0",
  "title": "S12FR exact replay pair diagnostic",
  "type": "object",
  "required": [
    "campaign", "pairId", "particleId", "matrixIndex",
    "oldComparatorPassed", "repairedComparatorPassed",
    "seedIdentityPassed", "rngConsumptionPassed",
    "instrumentationParityPassed", "pairGatePassed",
    "betaSha256Left", "betaSha256Right",
    "initialStateSha256Left", "initialStateSha256Right",
    "trajectorySha256Left", "trajectorySha256Right",
    "discreteDivergenceCount", "finiteNumericDivergenceCount",
    "permittedPairedNanCount", "forbiddenNonfiniteDifferenceCount",
    "rngDivergenceCount", "tracePayloadPath", "tracePayloadSha256"
  ],
  "properties": {
    "campaign": {"type": "string"},
    "pairId": {"type": "string", "minLength": 1},
    "particleId": {"type": "string", "minLength": 1},
    "matrixIndex": {"type": "integer", "minimum": 0},
    "oldComparatorPassed": {"type": "boolean"},
    "repairedComparatorPassed": {"type": "boolean"},
    "seedIdentityPassed": {"type": "boolean"},
    "rngConsumptionPassed": {"type": "boolean"},
    "instrumentationParityPassed": {"type": "boolean"},
    "pairGatePassed": {"type": "boolean"},
    "betaSha256Left": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "betaSha256Right": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initialStateSha256Left": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initialStateSha256Right": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trajectorySha256Left": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trajectorySha256Right": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "discreteDivergenceCount": {"type": "integer", "minimum": 0},
    "finiteNumericDivergenceCount": {"type": "integer", "minimum": 0},
    "permittedPairedNanCount": {"type": "integer", "minimum": 0},
    "forbiddenNonfiniteDifferenceCount": {"type": "integer", "minimum": 0},
    "rngDivergenceCount": {"type": "integer", "minimum": 0},
    "tracePayloadPath": {"type": "string", "minLength": 1},
    "tracePayloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
